# Copy to .env and fill in real values before running `docker compose up`.

# MariaDB (own container + volume — this demo never connects to any
# external/university system).
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_NAME=study_plan
MARIADB_ROOT_PASSWORD=change-me-root-password

# HMAC/session signing key for src/lib/session.ts. Any long random string.
SECRET_KEY=change-me-to-a-long-random-string

# Host ports (change if any of these collide with something else on your machine).
APP_PORT=8080
PHPMYADMIN_PORT=8081
SWAGGER_PORT=8082
